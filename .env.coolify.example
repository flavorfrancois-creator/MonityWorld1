# Backend URL used by the frontend Nginx reverse proxy.
# For the bundled Compose stack keep the internal service URL.
BACKEND_PROXY_URL=http://backend:8001

# Use a long random value in Coolify.
JWT_SECRET=replace-with-a-long-random-secret

DB_NAME=monity_world
CORS_ORIGINS=https://app.example.com
FRONTEND_PORT=3000

# Required for administrator email OTP verification.
# Self-hosted Stalwart: mail.monityworld.win, port 587 (STARTTLS), noreply mailbox.
SMTP_HOST=mail.monityworld.win
SMTP_PORT=587
SMTP_USERNAME=noreply@monityworld.win
SMTP_PASSWORD=replace-with-noreply-mailbox-password
SMTP_FROM=noreply@monityworld.win
